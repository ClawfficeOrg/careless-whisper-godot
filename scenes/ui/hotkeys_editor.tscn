[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hotkeys_editor.gd" id="1_hke"]

[node name="HotkeysEditor" type="VBoxContainer"]
script = ExtResource("1_hke")

[node name="TitleLabel" type="Label" parent="."]
text = "Hotkeys"
theme_override_font_sizes/font_size = 16

[node name="SubtitleLabel" type="Label" parent="."]
text = "Changes are saved immediately."
modulate = Color(0.7, 0.7, 0.7, 1)

[node name="ScrollContainer" type="ScrollContainer" parent="."]
size_flags_vertical = 3

[node name="RowsContainer" type="VBoxContainer" parent="ScrollContainer"]
size_flags_horizontal = 3
