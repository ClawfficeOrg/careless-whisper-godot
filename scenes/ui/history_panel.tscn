[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/history_panel.gd" id="1_panel"]

[node name="HistoryPanel" type="VBoxContainer"]
script = ExtResource("1_panel")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
