# Godot 4+ specific ignores
.godot/
*.godot.uid

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build outputs
*.a
*.o
# *.so — NOTE: do NOT ignore .so here; extension binaries in addons/ must be tracked
*.dylib
*.dll
*.lib

# Whisper models (large files)
models/*.bin

# GDExtension builds (add to addons/ separately)
# NOTE: the actual .so in addons/whisper_cpp/bin/ IS tracked (force-added)

*.uid
/addons/whisper_cpp/bin/
# Rust/Cargo build artifacts
/target/
**/target/
**/target/**

# Native binaries produced by builds - keep tracked addons explicitly where needed
# but ignore general native bin artifacts produced by local builds
**/*.pdb
**/*.exp
**/*.lib

# Godot addon build dirs
addons/*/bin/
addons/*/target/

# Editor / OS files
.vscode/
.idea/
*.swp
.DS_Store
